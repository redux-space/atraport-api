{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Application Health & Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "process_uptime_seconds",
          "legendFormat": "Uptime (seconds)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP Request Throughput (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "(sum(rate(http_errors_total[5m])) / sum(rate(http_requests_total[5m]))) * 100",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Requests in Flight",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "http_requests_in_flight",
          "legendFormat": "In-Flight Requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency (s)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "System Memory Usage (RSS vs Heap Used)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "process_memory_rss_bytes",
          "legendFormat": "Memory RSS Bytes",
          "refId": "A"
        },
        {
          "expr": "process_memory_heap_used_bytes",
          "legendFormat": "Heap Used Bytes",
          "refId": "B"
        },
        {
          "expr": "process_memory_heap_total_bytes",
          "legendFormat": "Heap Total Bytes",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "title": "Process CPU Usage Ratio",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "process_cpu_usage_ratio",
          "legendFormat": "CPU Usage Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Business Operations Metrics (Rebalancing & Risk)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "astraport_rebalancing_executions_total",
          "legendFormat": "Rebalancing Executions ({{status}})",
          "refId": "A"
        },
        {
          "expr": "astraport_risk_evaluations_total",
          "legendFormat": "Risk Score Evaluations Total",
          "refId": "B"
        },
        {
          "expr": "astraport_portfolio_analyses_total",
          "legendFormat": "Portfolio Analysis Requests",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["astraport", "nestjs", "observability", "prometheus"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "AstraPort API Observability Dashboard",
  "uid": "astraport-api-monitoring"
}
